<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.mobile.mymeds">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PERMISOS DE RED E INTERNET -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PERMISOS DE UBICACIÓN -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PERMISOS DE CÁMARA Y ARCHIVOS -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PERMISOS DE NOTIFICACIONES Y ALARMAS (RECORDATORIOS) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PERMISOS NFC -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FEATURES DEL HARDWARE (OPCIONALES) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="com.mobile.mymeds.MyMedsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyMeds"
        tools:targetApi="31">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- API KEY DE GOOGLE MAPS -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAeAshcyIaxXOjyu6ve5vbPaE7rCs1wF-Q" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITY PRINCIPAL - LOGIN -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.MyMeds">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITIES DE AUTENTICACIÓN -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.PasswordResetActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITIES PRINCIPALES -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITIES DE MAPA Y DELIVERY -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.MapActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.DeliveryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITIES DE FARMACIA -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.PharmacyInventoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.OrdersManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITIES DE PRESCRIPCIONES -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.PrescriptionsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.UploadPrescriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.UploadPrescriptionPhotoActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.UploadPrescriptionPDFActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.UploadByNfcActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACTIVITIES DE RECORDATORIOS Y ANÁLISIS -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <activity
            android:name="com.mobile.mymeds.views.MedicationRemindersActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <activity
            android:name="com.mobile.mymeds.views.AnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyMeds" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SERVICIOS -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <service
            android:name="com.mobile.mymeds.services.DrivingDetector"
            android:enabled="true"
            android:exported="false" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RECEIVERS -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- Receiver para mantener sesión -->
        <receiver
            android:name="com.mobile.mymeds.session.KeepSignedInReceiver"
            android:exported="false" />

        <!-- Receiver para reiniciar alarmas después de reinicio del dispositivo -->
        <receiver
            android:name="com.mobile.mymeds.views.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FILE PROVIDER PARA COMPARTIR ARCHIVOS -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- INICIALIZADOR DEL CACHÉ -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">

            <meta-data
                android:name="com.mobile.mymeds.initializers.CacheInitializer"
                android:value="androidx.startup" />

        </provider>


    </application>
</manifest>